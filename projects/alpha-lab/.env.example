# AlphaLab Environment Configuration
# Copy this to .env and fill in your values:
#   cp .env.example .env

# Absolute path to this repo. All other path-valued vars below derive from it.
ALPHALAB_HOME=/path/to/alpha-lab

# Python executable for experiment subprocesses (Phase 3)
# This should point to a Python with torch, numpy, pandas, etc. installed
ALPHALAB_PYTHON=/path/to/your/python

# LLM API (standard OpenAI API)
OPENAI_API_KEY=your-key-here
# Optional: point at an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://your-endpoint/v1

# Default to no tracing. Set OTEL_EXPORTER_OTLP_ENDPOINT to enable.
OTEL_TRACES_SAMPLER=always_off
# Uncomment this to run unit tests without network access.
# TIKTOKEN_CACHE_DIR=/path/to/tiktoken_cache

# Litellm - use bundled pricing data instead of fetching from GitHub.
# Uncomment on locked-down networks or to skip the startup HTTP fetch.
# LITELLM_LOCAL_MODEL_COST_MAP=true
