+/// Timing includes time from encoding function invocation to first token
+/// output.
+pub(crate) fn encode_files_docs_serial_profiled(
+    workers: &WorkerPool,
+    proto: &Tokenizer,
+    files: &[&[u8]],
+    format: &DocFormat,
+    started: Instant,
+) -> (Vec<u32>, Vec<i64>, Option<Duration>, Duration) {
+    let total: usize = files.iter().map(|f| f.len()).sum();
+    workers.with_serial_worker(proto, total, |tok| {
+        let mut ids: Vec<u32> = Vec::with_capacity(total / 4 + 16);
+        madvise_hugepage(ids.as_mut_ptr() as *mut u8, ids.capacity() * 4);
+        let mut lens = Vec::new();
+        let mut ttft = None;
+        let mut recorded = false;
+        let mut mark_first_ready = || {
+            ttft = Some(started.elapsed());
+        };
+        for &bytes in files {
+            for_each_doc(bytes, format, |doc| {
+                encode_into_profiled(
+                    tok,
+                    doc,
+                    &mut ids,
+                    &mut lens,
+                    &mut recorded,
+                    &mut mark_first_ready,
+                )
+            });
+        }
+        let elapsed = started.elapsed();
+        (ids, lens, ttft, elapsed)
+    })
+}
