+        }
+        let started = Instant::now();
+        let (tokens, total_tokens, ttft, elapsed) =
+            encode_files_ragged_profiled(py, &source, started, |files, format, started| {
+                encode_files_docs_serial_profiled(
+                    &self.workers,
+                    &self.tokenizer,
+                    files,
+                    format,
+                    started,
+                )
+            })?;
+        let profile = PyDict::new(py);
+        profile.set_item("total_tokens", total_tokens)?;
+        profile.set_item("ttft_seconds", ttft.map(|duration| duration.as_secs_f64()))?;
+        profile.set_item("elapsed_seconds", elapsed.as_secs_f64())?;
+        Ok((tokens, profile))
+    }
+
     /// Size of the vocabulary: one greater than the largest token ID,
     /// including added tokens.
