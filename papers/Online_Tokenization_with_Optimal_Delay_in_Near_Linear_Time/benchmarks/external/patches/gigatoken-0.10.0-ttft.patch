+/// Timing includes time from encoding function invocation to first token
+/// output.
+pub(crate) fn encode_files_ragged_profiled<'py>(
+    py: Python<'py>,
+    source: &Bound<'py, PyAny>,
+    started: Instant,
+    encode: impl FnOnce(&[&[u8]], &DocFormat, Instant) -> (
+        Vec<u32>,
+        Vec<i64>,
+        Option<Duration>,
+        Duration,
+    ) + Send,
+) -> PyResult<(Bound<'py, PyAny>, usize, Option<Duration>, Duration)> {
+    let (paths, format) = resolve_files_source(source)?;
+    let (flat, counts, ttft, elapsed) = py.detach(|| -> PyResult<_> {
+        let (flat, counts, ttft, elapsed) = if let DocFormat::Parquet { column } = &format {
+            let docs = load_parquet_docs(&paths, column, false)?;
+            let bytes: Vec<&[u8]> = docs.iter().map(|d| d.as_slice()).collect();
+            encode(
+                &bytes,
+                &DocFormat::Text { separator: None },
+                started,
+            )
+        } else {
+            let files = load_files(&paths, false)?;
+            let bytes: Vec<&[u8]> = files.iter().map(|f| f.as_bytes()).collect();
+            encode(&bytes, &format, started)
+        };
+        Ok((flat, counts, ttft, elapsed))
+    })?;
+    let total_tokens = flat.len();
+    Ok((
+        super::bridge::ragged_to_python(py, flat, counts)?,
+        total_tokens,
+        ttft,
+        elapsed,
+    ))
+}
