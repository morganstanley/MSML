+@pytest.mark.parametrize(
+    ("text", "allowed_special"),
+    [
+        ("", set()),
+        ("hello world", set()),
+        ("z" * 64, set()),
+        ("<|endoftext|>", "all"),
+    ],
+)
+def test_encode_to_numpy_profiled(text, allowed_special):
+    enc = tiktoken.get_encoding("r50k_base")
+    expected = enc.encode_to_numpy(text, allowed_special=allowed_special)
+    tokens, profile = enc.encode_to_numpy_profiled(text, allowed_special=allowed_special)
+
+    assert tokens.tolist() == expected.tolist()
+    assert profile.total_tokens == len(tokens)
+    assert profile.elapsed_seconds >= 0
+    if tokens.size:
+        assert profile.ttft_seconds is not None
+        assert 0 <= profile.ttft_seconds <= profile.elapsed_seconds
+    else:
+        assert profile.ttft_seconds is None
+
+
